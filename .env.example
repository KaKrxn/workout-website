# Copy to .env.local and fill in. Never commit a file with real values.
# See Report/06-deploy-vercel.md §2 and §5.

# Supabase — use the new key format (sb_publishable_… / sb_secret_…), not anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS — must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Random, 32+ characters. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# The real domain in production; leave empty on preview; localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
